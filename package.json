{
  "name": "utn-mcp",
  "version": "0.1.0",
  "description": "Servidor MCP para el campus virtual (Moodle) de la UTN Facultad Regional La Plata",
  "type": "module",
  "private": true,
  "bin": {
    "utn-mcp": "dist/cli.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js serve",
    "login": "tsx src/cli.ts login",
    "discover": "tsx src/cli.ts discover",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.13.0",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
